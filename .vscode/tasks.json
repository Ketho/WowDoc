{
	// See https://go.microsoft.com/fwlink/?LinkId=733558
	// for the documentation about the tasks.json format
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Lua",
			"type": "shell",
			"command": "source .lua/bin/activate && lua '${file}'",
			"presentation": {"showReuseMessage": false, "clear": true},
			"problemMatcher": []
		},
		{
			"label": "Python",
			"type": "shell",
			"command": "source .venv/bin/activate && python '${file}'",
			"presentation": {"showReuseMessage": false, "clear": true},
			"problemMatcher": []
		},
		{
			"label": "Pywikibot login",
			"type": "shell",
			"command": "source .venv/bin/activate && pwb login",
			"presentation": {"showReuseMessage": false, "clear": true},
			"problemMatcher": []
		},
		{
			"label": "0. Lua BlizzardInterfaceResources",
			"type": "shell",
			"command": "source .lua/bin/activate && lua 'Projects/UpdateResources/init.lua'",
			"presentation": {"showReuseMessage": false, "clear": true},
			"problemMatcher": []
		},
		{
			"label": "1. Lua warcraftwiki",
			"type": "shell",
			"command": "rm -r .wiki; source .lua/bin/activate && lua 'warcraftwiki/init.lua'",
			"presentation": {"showReuseMessage": false, "clear": true},
			"problemMatcher": []
		},
		{
			"label": "2. Lua update wiki tables",
			"type": "shell",
			"command": "source .lua/bin/activate && lua 'Scribunto/upload.lua'",
			"presentation": {"showReuseMessage": false, "clear": true},
			"problemMatcher": []
		},
		{
			"label": "3. Python upload new pages",
			"type": "shell",
			"command": "source .venv/bin/activate && pwb login && python 'Pywikibot/export/upload_new_pages.py'",
			"presentation": {"showReuseMessage": false, "clear": true},
			"problemMatcher": []
		},
		{
			"label": "4. Update framexml mirrors",
			"dependsOn": [
				"4.1 Update framexml midnight-ptr",
				"4.2 Update framexml mists",
				"4.3 Update framexml bcc",
				"4.4 Update framexml vanilla"
			],
			"dependsOrder": "sequence"
		},
		{
			"label": "4.1 Update framexml midnight-ptr",
			"type": "shell",
			"command": "cd \"/mnt/d/Repo/wow/wow-framexml/wow-ui-source midnight-ptr\" && git pull origin ptr && git push ketho ptr",
			"presentation": {"showReuseMessage": false, "clear": true},
			"problemMatcher": []
		},
		{
			"label": "4.2 Update framexml mists",
			"type": "shell",
			"command": "cd \"/mnt/d/Repo/wow/wow-framexml/wow-ui-source mists\" && git pull origin classic && git push ketho classic",
			"presentation": {"showReuseMessage": false, "clear": true},
			"problemMatcher": []
		},
		{
			"label": "4.3 Update framexml bcc",
			"type": "shell",
			"command": "cd \"/mnt/d/Repo/wow/wow-framexml/wow-ui-source bcc\" && git pull origin classic_anniversary && git push ketho classic_anniversary",
			"presentation": {"showReuseMessage": false, "clear": true},
			"problemMatcher": []
		},
		{
			"label": "4.4 Update framexml vanilla",
			"type": "shell",
			"command": "cd \"/mnt/d/Repo/wow/wow-framexml/wow-ui-source vanilla\" && git pull origin classic_era && git push ketho classic_era",
			"presentation": {"showReuseMessage": false, "clear": true},
			"problemMatcher": []
		},
		{
			"label": "Python parse_html",
			"type": "shell",
			"command": "source .venv/bin/activate && python Pywikibot/export/parse_html.py",
			"presentation": {"showReuseMessage": false, "clear": true},
			"problemMatcher": []
		},
		{
			"label": "Sync wowdoc",
			"type": "shell",
			"command": "rsync -av --delete wowdoc/ ~/vscode-wow-api/wowdoc/",
			"presentation": {"showReuseMessage": false, "clear": true},
			"problemMatcher": []
		}
	]
}